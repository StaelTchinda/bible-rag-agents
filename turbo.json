{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "ingest": {
      "cache": false
    },
    "build-index": {
      "dependsOn": ["ingest"],
      "outputs": ["dist-index/**"],
      "cache": false
    },
    "verify": {
      "cache": false
    }
  }
}
